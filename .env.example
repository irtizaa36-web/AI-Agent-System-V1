# Copy this file to .env and fill in real values. .env is gitignored and is
# never read, printed, or committed by Claude Code — only your own running
# process reads it, via `node --env-file=.env ...`.

# From Inkbox's console (API Keys section).
INKBOX_API_KEY=

# Your real Inkbox mailbox, e.g. toozy@inkboxmail.com
INKBOX_MAILBOX_ADDRESS=

# Your Inkbox agent/tunnel handle, e.g. toozy
INKBOX_TUNNEL_NAME=

# Your real personal email — every outbound send gets BCC'd here, every
# inbound message gets forwarded here. Leave blank to keep forwarding off.
OWNER_FORWARD_EMAIL=

# Comma-separated addresses whose forwarded mail you do NOT want a personal
# copy of. Matches on the message's ORIGINAL recipient (which Gmail preserves
# through forwarding), not the sender — that distinction is the whole point.
# Added 2026-09-16: a candidate's full Gmail-forwarded inbox (job alerts and
# her unrelated retail mail alike — Gmail forwarding is all-or-nothing) was
# flooding OWNER_FORWARD_EMAIL above. Leave blank to forward everything.
OWNER_FORWARD_EXCLUDE_RECIPIENTS=

# Anthropic API key, for unattended scheduled runs. Without it the pipeline
# still fetches and filters, but cannot SCORE — postings stop at the
# deterministic pre-filter and the digest says so plainly rather than
# pretending it ranked anything. Also what the feedback loop below uses to
# classify an inbound reply.
ANTHROPIC_API_KEY=

# UUID of the Inkbox agent identity to read and send iMessage as. Separate
# from INKBOX_SMS_PHONE_NUMBER_ID below — iMessage goes through Inkbox's
# shared router and every identity has it, where SMS needs a provisioned
# phone number and many identities have none. Inkbox's console lists this;
# nothing here can discover it on its own.
INKBOX_IDENTITY_ID=

# The signing key Inkbox gives you when you create your FIRST mail webhook
# subscription (shown once). See the runbook for the ordering wrinkle.
INKBOX_WEBHOOK_SIGNING_KEY=

# Optional. Only set this if you also set a bearer token when creating the
# webhook subscription in Inkbox's console.
INKBOX_WEBHOOK_AUTH_TOKEN=

# Optional, defaults to 8787.
INKBOX_WEBHOOK_PORT=

# --- Job-search pipeline: texting the daily digest (see ADR 0016) ---
# All four of these must be set for anything to actually get texted. Having
# credentials configured for testing is deliberately not the same thing as
# DIGEST_SMS_ENABLED being "true" — that flag is the one thing that turns on
# live automated sends to a real phone.

# UUID of the Inkbox phone number to send FROM. Inkbox's dashboard/API lists
# the numbers assigned to your identity — this is not something the pipeline
# can discover on its own, and "not every identity has one" (Inkbox's own
# words) until you provision one.
INKBOX_SMS_PHONE_NUMBER_ID=

# The destination, in E.164 format (e.g. +15551234567). Before this will
# actually deliver, Inkbox must have this number recorded as opted in
# (smsOptIns.optIn), which itself requires an active, carrier-registered
# 10DLC campaign on your account — a real compliance step, not a config
# value. Get her explicit agreement to receive this before setting it.
DIGEST_SMS_TO=

# Must be the literal string "true" — anything else (including leaving this
# blank) keeps texting off even if every other value above is set.
DIGEST_SMS_ENABLED=

# Optional, defaults to 5. How many roles the text lists before saying
# "+N more on the dashboard".
DIGEST_SMS_MAX_ROLES=

# --- Job-search pipeline: iMessaging the daily digest ---
# Same three-gate shape as the SMS block above, but a different Inkbox API
# (the iMessage router) and different prerequisites: needs INKBOX_IDENTITY_ID
# above rather than a provisioned phone number, so no 10DLC campaign and no
# smsOptIns step. Still get her explicit agreement before turning it on.

# Must be the literal string "true" — anything else keeps the digest text off.
DIGEST_IMESSAGE_ENABLED=

# The destination, E.164 (e.g. +15551234567). Note this doubles as her phone
# IDENTITY for the feedback loop below: a text FROM this number is treated as
# her own feedback. That reuse is deliberate (one setting, not two that could
# drift apart), and it works independently of DIGEST_IMESSAGE_ENABLED —
# texting feedback IN and receiving the digest OUT are separate choices.
DIGEST_IMESSAGE_TO=

# Optional, defaults to 5.
DIGEST_IMESSAGE_MAX_ROLES=

# --- Job-search pipeline: emailing the daily digest ---
# Preferred over the text channel for a real search: every shortlisted role
# with full rationale/gaps and a real clickable apply link per role, with no
# length cap SMS/iMessage impose.

# Must be the literal string "true" — anything else keeps the digest email off.
DIGEST_EMAIL_ENABLED=

# Her real email. Doubles as her email IDENTITY for the feedback loop below,
# the same way DIGEST_IMESSAGE_TO does for texts — a message FROM this
# address, sent directly TO the Inkbox mailbox, is treated as her feedback.
DIGEST_EMAIL_TO=

# --- Job-search pipeline: the feedback loop ---
# When she replies directly — by email or by text — her message is read,
# any question answered, and any preference change she asked for applied to
# her own config/job-search/<profile>/preferences.json AUTOMATICALLY, with no
# approval step. That is a deliberate, explicitly-requested exception (Irtiza,
# 2026-09-16) to this project's normal human-approval posture, and it is
# narrow: only an allow-listed set of preference fields can change, a
# type-mismatched or ambiguous request is reported back to her rather than
# guessed at, and every applied change is committed and pushed so it survives
# a re-pull. "No approval step" and "no guessing" are different rules here.
#
# Identities come from DIGEST_EMAIL_TO / DIGEST_IMESSAGE_TO above; classifying
# her message needs ANTHROPIC_API_KEY. Runs once at the end of each
# `jobs run`, or on demand via `jobs check-feedback` — schedule that more
# often than daily if you want faster turnaround. If `inkbox serve-webhook`
# is running and FEEDBACK_LOOP_PROFILE (below) is set, an inbound message
# also triggers an immediate check — no polling wait either way.
#
# Must be the literal string "true" — anything else keeps the loop off.
FEEDBACK_LOOP_ENABLED=

# Which profile's feedback loop `inkbox serve-webhook` should check in real
# time when a message arrives — e.g. "shivani". Only read by the webhook
# receiver; `jobs check-feedback`/`jobs run` still take their own --profile
# and don't need this. Left unset, an inbound message just waits for the
# next scheduled or manual `jobs check-feedback` instead — deliberately not
# guessed, since guessing wrong would apply one candidate's reply to
# another's config (ADR 0017).
FEEDBACK_LOOP_PROFILE=

# --- Customer service: the returns autopilot (see ADR 0018) ---
# Removes the human approval gate on `browser-submit-form` — the one thing
# standing between a model's decision and a live click on a real retailer's
# website (ADR 0011). Set deliberately, per Irtiza's 2026-09-17 call, for
# retailer returns specifically. The job-search stewards still stage and
# stop unconditionally; that rule is unchanged and is not affected by this.
#
# Only the literal string "true" opens the gate. "1", "yes", "TRUE" and
# empty all leave it closed.
#
# Two things this does NOT do, worth reading before setting it:
#   1. It does not make the judgment safe. The Tool is generic — it fills
#      selectors and clicks a control, and cannot tell a return form from a
#      checkout page. The stops that matter (CAPTCHA, ID verification,
#      anything moving money away from you) live in the agent's own
#      instructions at .claude/agents/customer-service-steward.md.
#   2. It does not make anything runnable on its own. An authenticated
#      browser session per retailer must exist first
#      (.orchestrator/browser-sessions/, created via `browser login` with a
#      real visible browser). Without one, setting this changes nothing.
RETURNS_AUTOPILOT_ENABLED=

# Polymarket US trading API (ADRs 0019, 0020). Market search and prices work
# without these; previewing or placing an order needs both. Placing an order
# always requires your exact-match approval (orchestrator dispatch approve).
# POLYMARKET_KEY_ID=
# POLYMARKET_SECRET_KEY=
#
# Largest single order allowed, in dollars. Unset or invalid means $10.
# POLYMARKET_MAX_ORDER_USD=10

# Sleeper fantasy + pick'em (ADR 0021, docs/sleeper-agent.md). Reads need
# nothing. League writes (lineup, IR, taxi, add/drop, waivers, trades) need
# your own Sleeper session token: sleeper.com -> DevTools -> Network ->
# a "graphql" request -> the "authorization" request header. Every write is
# a dry run unless you pass --confirm (CLI) or approve it (agent). Never
# commit the real value. Email/password login is deliberately not supported.
# SLEEPER_TOKEN=
#
# Timezone for the pick'em "plays per day" count. Defaults to America/New_York.
# PICKEM_TIMEZONE=America/New_York

# Orchestrator brief watcher (ADR 0027, `orchestrator watch-briefs poll|loop`).
# A token with read access to list branches and file contents on this repo
# (a fine-grained PAT scoped to Contents: Read-only is enough — the watcher
# never writes through the GitHub API, only via local git). Never commit the
# real value.
# GITHUB_TOKEN=
#
# Optional. Default to this project's own repository.
# GITHUB_REPO_OWNER=irtizaa36-web
# GITHUB_REPO_NAME=AI-Agent-System
#
# Optional. The branch new working branches are created off of. Default: main.
# GITHUB_BASE_BRANCH=main

# --- Job-search pipeline: public job boards (Shivani's profile only) ---
# Remotive and RemoteOK need no credentials. Adzuna does: register a free app
# at https://developer.adzuna.com and paste its App ID and App Key here. With
# either blank the Adzuna source is skipped (a one-line note is printed) and
# the other boards still run. Never commit the real values.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Call recording and transcription (ADR 0030, docs/operations/call-transcription.md) ---
# Local only: ffmpeg records, whisper.cpp transcribes, nothing is uploaded.
# Absolute path to a downloaded whisper.cpp ggml model. Required to transcribe.
WHISPER_MODEL=
# Optional. Defaults shown.
# CALLS_AUDIO_DEVICE=Call Capture
# WHISPER_LANGUAGE=auto
# WHISPER_BIN=whisper-cli
# CALLS_FFMPEG=ffmpeg
